<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Blurt</string>
    <key>CFBundleDisplayName</key>
    <string>Blurt</string>
    <key>CFBundleIdentifier</key>
    <string>com.nerflabs.blurt</string>
    <key>CFBundleExecutable</key>
    <string>Blurt</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.3</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Contents/Resources/AppIcon.icns, generated by scripts/make-icon.swift.
         Named without the extension, which is what CFBundleIconFile expects. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Menu bar only: no Dock icon, no main window. -->
    <key>LSUIElement</key>
    <true/>

    <!-- Sparkle. The feed is GitHub's "latest/download" URL, which redirects to
         the newest release's copy of appcast.xml — so uploading that file with
         a release is the whole act of publishing an update: nothing to commit,
         no second host to keep alive. The public key checks the EdDSA
         signature on every download; its private half lives only in the
         release machine's keychain. release-macos.sh refuses to publish if
         the two ever disagree. -->
    <key>SUFeedURL</key>
    <string>https://github.com/NathanFeeser/blurt/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>hpp1kyKe8wgDR44laPtpWC7cJBC4P2u4jjJl1OjVvG4=</string>

    <!-- Check once a day without asking first. Sparkle's default is a
         permission dialog on the second launch, which would land on somebody
         who has just finished setup. The check is one GET for the appcast and
         system profiling stays off. See README, Privacy. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>

    <key>NSMicrophoneUsageDescription</key>
    <string>Blurt records your voice while you hold the dictation key, and sends it to the transcription provider you configured.</string>

    <!-- No App Sandbox key on purpose. The Accessibility APIs used to read
         context and insert text require an unsandboxed process, which is also
         why this app can never ship on the Mac App Store. -->
</dict>
</plist>
