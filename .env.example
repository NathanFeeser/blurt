# Copy to .env and fill in whatever you use:  cp .env.example .env
#
# Development convenience for the `blurt` CLI only. The macOS/iOS/Windows
# apps read keys from the OS keychain and never from a file — see the privacy
# model in docs/ARCHITECTURE.md.
#
# .env is gitignored. Keep it that way; never commit a real key.

# --- Speech-to-text -------------------------------------------------------
# Groq is the default: whisper-large-v3-turbo at ~$0.04/hr of audio.
# Key from https://console.groq.com/keys
GROQ_API_KEY=

# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=

# --- Local / self-hosted --------------------------------------------------
# These need no key. Set a base URL only if it isn't on the default port.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# VLLM_BASE_URL=http://localhost:8000/v1

# --- Any other OpenAI-compatible endpoint ---------------------------------
# Use with: --stt-provider openai-compat  /  --llm-provider openai-compat
# BLURT_BASE_URL=
# BLURT_API_KEY=
